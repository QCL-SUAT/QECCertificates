# Lean build artefacts (regenerated by `lake build`)
.lake/
*.olean
*.ilean
*.trace

# Python
__pycache__/
*.pyc

# Run-time artefacts of the certificate chain: CNF, DRAT, LRAT, solver logs.
# Regenerated, large, and platform dependent.
tools/**/*.drat
tools/**/*.lrat
tools/**/validate_*.cnf
tools/**/cadical_*.log

# Deposit archives, regenerated by tools/package_deposit.py
dist/

# LaTeX intermediate files, regenerated by latexmk under paper/.
# main.pdf is a deliverable and is tracked, so *.pdf is deliberately not ignored.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.toc
paper/*.synctex.gz

# Working scratch: build logs, measurement samples, one-off probes
.verify/

# Machine-local configuration written by ~/.claude/bin/ctxprofile.py
.claude/

# System and editor
.DS_Store
._*
*.log
