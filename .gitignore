# Lean build artefacts (regenerated by `lake build`)
.lake/
*.olean
*.ilean
*.trace

# Python
__pycache__/
*.pyc

# Run-time artefacts of the certificate chain: CNF, DRAT, LRAT, solver logs.
# Regenerated, large, and platform dependent.
tools/**/*.drat
tools/**/*.lrat
tools/**/validate_*.cnf
tools/**/cadical_*.log

# Deposit archives, regenerated by tools/package_deposit.py
dist/

# The paper drafts are local-only. A JOSS submission carries its paper.md on a
# short-lived branch created from the default branch, never on the default itself.
/paper/

# Working scratch: build logs, measurement samples, one-off probes
.verify/

# Machine-local configuration written by ~/.claude/bin/ctxprofile.py
.claude/

# System and editor
.DS_Store
._*
*.log
